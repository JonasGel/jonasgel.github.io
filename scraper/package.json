{
  "name": "kulturwerkstatt-scraper",
  "version": "0.1.0",
  "description": "Scraper für Veranstaltungen der Kulturwerkstatt Forum e.V. auf Lübeck-Ticket",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "scrape": "tsx src/index.ts",
    "scrape:fixture": "tsx src/index.ts --fixture fixtures/sample.html",
    "test": "node src/parser.test.mjs",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
