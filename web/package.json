{
  "name": "kulturwerkstatt-forum-web",
  "version": "0.1.0",
  "description": "Website der Kulturwerkstatt Forum e.V., Neustadt in Holstein",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "scrape": "cd ../scraper && npm run scrape -- --out ../web/src/data/events.json",
    "scrape:fixture": "cd ../scraper && npm run scrape:fixture -- --out ../web/src/data/events.json",
    "prebuild": "npm run scrape"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
